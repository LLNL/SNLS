#
#=== Usage ===================================================================
# This file allows SNLS to be automatically detected by other libraries
# using CMake.  To build with SNLS, you can do one of two things:
#
#   1. Set the SNLS_DIR environment variable to the root directory of the SNLS
#      installation.  If you loaded RAJA through a dotkit, this may already
#      be set, and SNLS will be autodetected by CMake.
#
#   2. Configure your project with this option:
#      -SNLS_DIR=<SNLS install prefix>/share/
#
# If you have done either of these things, then CMake should automatically find
# and include this file when you call find_package(snls) from your
# CMakeLists.txt file.
#
#=== Components ==============================================================
#
# To link against these, just do, for example:
#
#   find_package(snls REQUIRED)
#   add_executable(foo foo.c)
#   target_link_libraries(foo snls)
#
# That's all!
#

cmake_minimum_required(VERSION 3.21 FATAL_ERROR)

@PACKAGE_INIT@

if(@USE_RAJA_ONLY@ OR @USE_BATCH_SOLVERS@)
  if(NOT TARGET camp)
    find_dependency(camp CONFIG NO_DEFAULT_PATH PATHS ${CAMP_DIR} @CAMP_DIR@)
  endif()

  if(NOT TARGET RAJA)
    find_dependency(raja CONFIG NO_DEFAULT_PATH PATHS ${RAJA_DIR} @RAJA_DIR@)
  endif()
endif()

if(@USE_BATCH_SOLVERS@)
  if(NOT TARGET fmt::fmt AND NOT TARGET fmt::fmt-header-only)
    find_dependency(fmt CONFIG NO_DEFAULT_PATH PATHS ${FMT_DIR} @FMT_DIR@)
  endif()

  if(NOT TARGET umpire)
    find_dependency(umpire CONFIG NO_DEFAULT_PATH PATHS ${UMPIRE_DIR} @UMPIRE_DIR@)
  endif()

  if(NOT TARGET chai)
    find_dependency(chai CONFIG NO_DEFAULT_PATH PATHS ${CHAI_DIR} @CHAI_DIR@)
  endif()
endif()

set(SNLS_INSTALL_PREFIX "${PACKAGE_PREFIX_DIR}")
set(SNLS_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include/snls")
set(SNLS_LIB_DIR "${PACKAGE_PREFIX_DIR}/lib")
set(SNLS_CMAKE_DIR "${PACKAGE_PREFIX_DIR}/share/snls/cmake")

set(SNLS_USE_RAJA_ONLY @SNLS_USE_RAJA_ONLY@)
set(SNLS_USE_RAJA_PORT_SUITE @SNLS_USE_RAJA_PORT_SUITE@)

# Export version number
set(SNLS_VERSION_MAJOR @SNLS_VERSION_MAJOR@)
set(SNLS_VERSION_MINOR @SNLS_VERSION_MINOR@)
set(SNLS_VERSION_PATCH @SNLS_VERSION_PATCH@)

include("${CMAKE_CURRENT_LIST_DIR}/snls-targets.cmake")

check_required_components(SNLS)
